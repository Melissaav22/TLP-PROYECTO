# Copia este archivo a .env y guarda las claves únicamente en la copia local.
# Selecciona un perfil: gemini, openai, anthropic, custom o uno definido por ti.
LLM_PROVIDER=gemini

# Valores compartidos por los perfiles; personalízalos con el prefijo del proveedor.
# Sin estos valores se procesan todas las oraciones y solicitudes del corpus.
# LLM_LIMIT=67
# LLM_MAX_NEW_CALLS=134
LLM_BATCH_SIZE=1
LLM_MAX_COMPLETION_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Gemini Developer API, clave de Google AI Studio.
GEMINI_PROTOCOL=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_MIN_SECONDS_BETWEEN_CALLS=5.5

# OpenAI Chat Completions, clave de OpenAI Platform.
OPENAI_PROTOCOL=chat-completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_TOKEN_FIELD=max_completion_tokens
OPENAI_JSON_MODE=true

# Claude Messages, clave de Anthropic Console.
ANTHROPIC_PROTOCOL=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

# Otro proveedor con el formato Chat Completions.
CUSTOM_PROTOCOL=chat-completions
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_ENDPOINT=
CUSTOM_TOKEN_FIELD=max_tokens
CUSTOM_JSON_MODE=false

# Opcionales para un perfil concreto:
# GEMINI_OUTPUT_DIR=resultados/llm
# GEMINI_MAX_COMPLETION_TOKENS=4096
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
